// HackGuard AI — Prisma schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  candidate
  organizer
}

enum HackathonType {
  standard
  live
}

enum HackathonStatus {
  Live
  Upcoming
  Completed
}

model TestCase {
  tid     String  @id @default(cuid())
  input   String
  output  String
  problem Problem @relation(fields: [pid], references: [problemId], onDelete: Cascade)
  pid     String
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(candidate)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  submissions   Submission[]
  hackathons    Hackathon[]    @relation("HackathonOrganizer")
  registrations Registration[]
}

model Submission {
  id          String   @id @default(cuid())
  sourceCode  String   @db.Text
  language    String
  submittedAt DateTime @default(now())

  participantId String
  participant   User   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  problemId String
  problem   Problem @relation(fields: [problemId], references: [problemId], onDelete: Cascade)

  submittedByMemberId String?
  submittedByMember   RegistrationMember? @relation(fields: [submittedByMemberId], references: [id], onDelete: SetNull)

  reportsAsTarget    PlagiarismReport[] @relation("ReportTarget")
  reportsAsCandidate PlagiarismReport[] @relation("ReportCandidate")

  @@index([problemId, submittedAt])
  @@index([participantId, problemId])
  @@index([registrationId, problemId])
}

model PlagiarismReport {
  id String @id @default(cuid())

  targetSubmissionId String
  targetSubmission   Submission @relation("ReportTarget", fields: [targetSubmissionId], references: [id], onDelete: Cascade)

  candidateSubmissionId String
  candidateSubmission   Submission @relation("ReportCandidate", fields: [candidateSubmissionId], references: [id], onDelete: Cascade)

  tokenSimilarity Float
  matchedNgrams   Int
  riskLevel       String
  warnings        String[] @default([])
  createdAt       DateTime @default(now())

  @@unique([targetSubmissionId, candidateSubmissionId])
  @@index([riskLevel, createdAt])
}

model Problem {
  problemId   String       @id @default(cuid())
  name        String
  description String
  testcases   TestCase[]
  hackathonId String
  hackathon   Hackathon    @relation(fields: [hackathonId], references: [id])
  submissions Submission[]

  @@unique([hackathonId, name])
}

model Hackathon {
  id            String          @id @default(cuid())
  name          String
  date          DateTime
  description   String
  status        HackathonStatus @default(Upcoming)
  participants  Int             @default(0)
  submissions   Int             @default(0)
  organizer     User            @relation("HackathonOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  type          HackathonType   @default(standard)
  problems      Problem[]
  registrations Registration[]
}

model Registration {
  id          String               @id @default(cuid())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  hackathon   Hackathon            @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  hackathonId String
  members     RegistrationMember[]
  createdAt   DateTime             @default(now())
  submissions Submission[]

  @@unique([hackathonId, userId])
}

model RegistrationMember {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String
  name           String
  email          String
  isLeader       Boolean      @default(false)
  position       Int          @default(0)
  submissions    Submission[]

  @@index([registrationId])
}
